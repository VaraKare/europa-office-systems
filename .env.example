# Copy to .env.local for local development. Never commit real values.
# Every variable is optional: the site builds and works without any of them.

# ---- Site ----
# Canonical production origin. Used for canonicals, sitemap, robots, JSON-LD and OG URLs.
NEXT_PUBLIC_SITE_URL=https://europaofficesystems.com

# ---- Enquiry form delivery (server-side only, never exposed to the browser) ----
# Configure AT LEAST ONE delivery channel. If none is configured, the form returns an
# honest "not configured" error and offers phone/WhatsApp instead. It never fakes success.

# Option A: POST the enquiry as JSON to a webhook you control
# (e.g. Google Apps Script -> Google Sheet, Make, Zapier, n8n, your CRM).
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the "X-Enquiry-Secret" header so the receiver can reject forgeries.
ENQUIRY_WEBHOOK_SECRET=

# Option B: send an email through Resend (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# ---- Analytics / advertising (public IDs, safe in the browser) ----
# Leave empty to disable. Tags load ONLY after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion label for server-confirmed quote form leads (send_to = ADS_ID/LABEL).
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
# Google Ads "calls from website" conversion. Uses Google forwarding numbers where available in India;
# check availability in your Ads account before enabling.
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=
